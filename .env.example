# Copia este archivo a .env.local y rellena con los datos de tu proyecto de
# Supabase (Project Settings > API en el panel de Supabase).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Nombre del equipo/categoría que se muestra en la app (título de la pestaña,
# cabecera de cada partido, PWA...). Cada equipo/categoría del club que use
# este mismo código (con su propio proyecto de Supabase) pone aquí el suyo,
# p.ej. "BERA BERA CADETE". Si se deja vacío, usa "BERA BERA" por defecto.
VITE_TEAM_NAME=BERA BERA
